# Telegram Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_or_id

# Twitter Settings
# Twitter account to MONITOR
TWITTER_USERNAME=twitter_account_to_monitor

# Burner Twitter/X account used for scraping (do NOT use your main account)
TWITTER_AUTH_EMAIL=your_burner@gmail.com
TWITTER_AUTH_USERNAME=your_burner_twitter_username
TWITTER_AUTH_PASSWORD=your_burner_password

# Nitter Settings
# List of public Nitter instances (the bot will auto-fallback if one is down)
NITTER_INSTANCES=nitter.net,nitter.privacydev.net,nitter.poast.org

# App Settings
# How often to check for new tweets, in seconds. 30 is recommended for near real-time.
POLL_INTERVAL_SECONDS=30
